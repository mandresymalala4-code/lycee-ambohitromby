# Modèle de configuration pour l'hébergement (PythonAnywhere). Copiez ce fichier en ".env" puis modifiez les 3 lignes marquées ***.
# Le fichier .env ne doit JAMAIS être envoyé sur GitHub (il est ignoré par .gitignore).

# *** Générez une clé unique :  python -c "import secrets;print(secrets.token_urlsafe(50))"
SECRET_KEY=COLLEZ-ICI-VOTRE-CLE-SECRETE
DEBUG=False
# *** Remplacez VOTRE_NOM par votre nom d'utilisateur PythonAnywhere
ALLOWED_HOSTS=VOTRE_NOM.pythonanywhere.com        # exemple : tsiresy.pythonanywhere.com
DB_ENGINE=sqlite
# *** Adresse de votre site frontend (Cloudflare Pages). Plusieurs adresses possibles, séparées par des virgules.
CORS_ORIGIN=https://VOTRE-SITE.workers.dev        # adresse EXACTE du site (Cloudflare), sans / final
